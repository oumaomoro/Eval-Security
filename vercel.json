{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["server/**", "shared/**", "scripts/verify-health.ts"],
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.ts"
    }
  ],

  "env": {
    "NODE_ENV": "production",
    "FRONTEND_URL": "https://costloci.com",
    "API_URL": "https://api.costloci.com",
    "ALLOWED_ORIGINS": "https://costloci.com,https://www.costloci.com,https://api.costloci.com,https://costloci-frontend.pages.dev"
  },
  "crons": [
    {
      "path": "/api/cron/process-schedules",
      "schedule": "0 0 * * *"
    }
  ]
}
